{# form:sends data via a POST request to the server # #}
{#  in order to send data to server, we need attributes in the form #}
{# attribute: method, action #}
{# method --> what type of http request are we making? for forms this will always be POST #}
{# action is the route that will handle the data on the server #}
{# for every <form></form> html with a method and action, we need a app.post in the server.js #}
<form>
    {# inputs are the data to be sent #}
    {# in order to process the data, we need to include the name attribute which will name te property in the request.body #}
    <input type="text" placeholder="name" name="user">
    <input type="text" placeholder="write a message" name="message">
    <input type="submit" value="sendMessage">
</form>