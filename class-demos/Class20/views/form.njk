<html>
	<head>
		<title>class 20 demo</title>
		<link href="style.css" rel="stylesheet" />
	</head>
	<body>
		<section class="left"></section>
		<form method="POST" action="/add-data">
			<input type="text" name="text" placeholder="add some text data" />
			<input type="number" name="count" placeholder="add a number" />
			<input type="text" name="username" placeholder="add your name" />
			<input type="url" name="url" placeholder="add a link" />
			<input type="submit" value="send data" />
		</form>
		<section class="right"></section>
	</body>
</html>
