<html>
	<head>
		<meta charset="utf-8" />
		<!-- makes it not tiny on phones -->
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Designer Squad</title>
		<!-- font from google fonts -->
		<!-- Rock Salt is the handwritten title font from my figma -->
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400&family=Rock+Salt&display=swap"
			rel="stylesheet"
		/>
		<link href="/project3/style.css" rel="stylesheet" />
		<script src="/project3/main.js"></script>
	</head>
	<body>
		<!-- HEADER -->
		<div id="header">
			<!-- the paint scribbles are exported straight from figma -->
			<img id="logo" src="/project3/assets/logo.svg" alt="paint scribbles" />
			<h1 id="title">Designer Squad</h1>
			<p id="intro">
				If you're here, you're probably one of the goated designers I know personally. A lot of
				people ask me for designer recs, so I'll use this list when I'm referring people or when I
				come across a cool opportunity.
			</p>
			<p id="claim-text">Claim one of the spaces below and add your profile to the list</p>
			<p id="created-by">made by jen</p>
		</div>

		<!-- QR CODE -->
		<div id="qr-section">
			<!-- made this on goqr.me. it links to the form page -->
			<img id="qr" src="/project3/assets/qr-code.png" />
			<p>Scan the QR code to claim a spot</p>
		</div>

		<!-- DIRECTORY -->
		<!-- the 20 blobs are in views/partial-spots.njk now so the form page can use the same ones -->
		<!-- the whole directory is one link to the form page (before, every spot was its own link) -->
		<a id="directory" href="/project3/form">
			{% include "partial-spots.njk" %}
		</a>

		<!-- FOOTER -->
		<div id="footer">
			<div id="together">
				<div class="line"></div>
				<p>Better things are created together.</p>
				<div class="line"></div>
			</div>
			<div id="footer-info">
				<p>@2026</p>
			</div>
		</div>
		<img id="footer-scribble" src="/project3/assets/footer-scribble.svg" alt="" />
	</body>
</html>
