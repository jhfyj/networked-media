<!-- this is the page the qr code goes to. made for phones -->
<html>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Claim a spot</title>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400&display=swap" rel="stylesheet" />
		<link href="/project3/style.css" rel="stylesheet" />
		<script src="/project3/form.js"></script>
	</head>
	<body class="phone">
		<div class="top-bar">
			<a class="back" href="/project3"><img src="/project3/assets/icon-back.svg" alt="back" /></a>
			<p>Choose one of the spaces below</p>
		</div>

		<!-- the blobs and the form are on the same page now, so nothing has to be hidden -->
		<!-- same 20 blobs as the directory (views/partial-spots.njk). form.js turns the taken ones gray -->
		<div id="picker">
			{% include "partial-spots.njk" %}
		</div>

		<!-- action: route on the server. method: POST -->
		<form id="profile-form" action="/project3/add-designer" method="POST">
			<p>draw your face on the blob you picked!</p>

			<!-- the drawing area. blob picture in the back, canvas on top -->
			<!-- width + height have to be on the canvas tag itself or the drawing gets stretched -->
			<div id="canvas-box">
				<img id="canvas-blob" alt="" />
				<canvas id="draw-canvas" width="200" height="240"></canvas>
			</div>

			<div id="tools">
				<!-- pen + eraser icons are from figma -->
				<button type="button" id="pen" class="tool selected"><img src="/project3/assets/icon-pen.svg" alt="pen" /></button>
				<button type="button" id="eraser" class="tool"><img src="/project3/assets/icon-erase.svg" alt="eraser" /></button>
				<!-- type="button" so it doesnt send the form -->
				<button type="button" id="clear" class="tool">clear</button>
			</div>

			<!-- hidden inputs. form.js puts the spot + the drawing png in here right before it sends -->
			<input type="hidden" name="spot" id="spot-input" />
			<input type="hidden" name="drawing" id="drawing-input" />

			<label>First Name</label>
			<input type="text" name="firstName" placeholder="Jennifer" />

			<label>Last Name</label>
			<input type="text" name="lastName" placeholder="Huang" />

			<label>Role</label>
			<select name="role">
				<option value="Product Design">Product Designer</option>
				<option value="Brand Design">Brand Designer</option>
				<option value="Graphic Design">Graphic Designer</option>
				<option value="UX Research">UX Researcher</option>
				<option value="Motion Design">Motion Designer</option>
				<option value="Design Engineering">Design Engineer</option>
				<option value="Illustration">Illustrator</option>
			</select>

			<label>Website</label>
			<input type="text" name="website" placeholder="yourwebsite.com" />

			<input type="submit" value="SUBMIT" class="black-button" />
		</form>
	</body>
</html>
